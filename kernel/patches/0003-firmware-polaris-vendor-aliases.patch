Subject: [LOCAL] firmware-xiaomi-polaris: add vendor-qualified aliases

Keep legacy files and add aliases matching the current polaris DT requests.
Map the GPU firmware into the requested initramfs destination as well.
Packaging tested locally only; not installed on the phone.

---
diff --git a/device/archived/firmware-xiaomi-polaris/APKBUILD b/device/archived/firmware-xiaomi-polaris/APKBUILD
--- a/device/archived/firmware-xiaomi-polaris/APKBUILD
+++ b/device/archived/firmware-xiaomi-polaris/APKBUILD
@@ -3,7 +3,7 @@
 maintainer=""
 pkgname=firmware-xiaomi-polaris
 pkgver=2
-pkgrel=0
+pkgrel=1
 pkgdesc="Firmware for Xiaomi Mi Mix2s"
 url="https://github.com/MollySophia/firmware-xiaomi-polaris"
 arch="aarch64"
@@ -24,6 +24,16 @@
 	for i in $(cat "$srcdir"/firmware.files); do
 		install -Dm644 "$i" "$pkgdir/$i"
 	done
+
+	# Match the vendor-qualified firmware names requested by current DTs.
+	mkdir -p "$pkgdir/lib/firmware/qcom/sdm845/Xiaomi/polaris"
+	for i in "$pkgdir"/lib/firmware/qcom/sdm845/polaris/*; do
+		ln -s "../../polaris/${i##*/}" \
+			"$pkgdir/lib/firmware/qcom/sdm845/Xiaomi/polaris/${i##*/}"
+	done
+	mkdir -p "$pkgdir/lib/firmware/qca/Xiaomi/polaris"
+	ln -s ../../polaris/crnv21.bin \
+		"$pkgdir/lib/firmware/qca/Xiaomi/polaris/crnv21.bin"
 }
 
 firmware_initramfs() {
@@ -39,5 +49,5 @@
 sha512sums="
 49140fbdf15dbf181e1c35788970b45be78c3959222c455133495ee8ad4c6d76581926dfc2eb1ca32f2cdd6390d9fe05c2c497929cd9e3286591bfe8b5ff54eb  firmware-xiaomi-polaris.tar.gz
 2955450e7b6852f0353140e545237cd9746bddcb929657603df7bee43c29512d5d1ad9a480fb1e1e833aab68149222b61e92cba7406923bb67bea59b63ebe066  firmware.files
-7d430240abae210dd28db688258b45d025915db6fe60345346a1d2d12d7f5bddb0755b3bed8689f54081b7a5188d04906b95c1ea6bbf599019e54544bde1210b  30-gpu-firmware.files
+daf197cc62311f17a4abe0adcca2c60f08126629e13f863be1fd6a96c83eac48453ae6c77886d163b172f6c7d4475533a3eb143932281cfea4f7ffd4df416252  30-gpu-firmware.files
 "
diff --git a/device/archived/firmware-xiaomi-polaris/30-gpu-firmware.files b/device/archived/firmware-xiaomi-polaris/30-gpu-firmware.files
--- a/device/archived/firmware-xiaomi-polaris/30-gpu-firmware.files
+++ b/device/archived/firmware-xiaomi-polaris/30-gpu-firmware.files
